# Vorlage für .env.prod auf dem Server (niemals einchecken). Siehe DEPLOY.md
# Werte mit „ÄNDERN“ ersetzen; Zufallswerte z.B. mit: openssl rand -base64 36

# Adresse der App: eigene Domain (DNS-A-Eintrag auf den Server) oder <ip-mit-bindestrichen>.sslip.io
DOMAIN=ÄNDERN

POSTGRES_DB=gartengeist
POSTGRES_USER=gartengeist
POSTGRES_PASSWORD=ÄNDERN

# Mindestens 32 Zeichen
JWT_KEY=ÄNDERN

# Wird beim Registrieren abgefragt – nur an euch zwei weitergeben
REGISTRIERUNGSCODE=ÄNDERN

# Ordner für die täglichen Backups (außerhalb des Code-Ordners, der bei jedem Deployment ersetzt wird)
BACKUP_DIR=/opt/gartengeist/backups

# Für den KI-Assistenten (Phase 5), vorerst leer lassen
ANTHROPIC_API_KEY=
