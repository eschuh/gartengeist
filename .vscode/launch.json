{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/backend/Gartengeist.Api/bin/Debug/net10.0/Gartengeist.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/Gartengeist.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5101"
      }
    },
    {
      "name": "Launch Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/frontend/src",
      "preLaunchTask": "start: frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Launch API", "Launch Frontend"],
      "stopAll": true
    }
  ]
}
